# Copy to .env and fill in values. .env is gitignored.

# Market: CN-Stock | US-Stock
CONTEST_TRADE_MARKET=CN-Stock

# --- Data source API keys ---
TUSHARE_KEY=
JQDATA_USERNAME=
JQDATA_PASSWORD=
JQDATA_ACCOUNT_TYPE=formal
# auto | jqdata | akshare — 正式会员用 jqdata
CN_MARKET_DATA_PROVIDER=jqdata
BOCHA_KEY=
SERP_KEY=
FMP_KEY=
FINNHUB_KEY=
ALPHA_VANTAGE_KEY=
POLYGON_KEY=

# --- Doubao search (Volcengine) ---
# https://docs.volcengine.com/docs/87772/2272949?lang=zh
VOLC_WEB_SEARCH_API_KEY=
VOLC_WEB_SEARCH_BASE_URL=https://open.feedcoopapi.com/search_api/web_search

# --- LLM (main) ---
LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_NAME=

# --- DeepSeek (optional; does not replace LLM_*) ---
# Host origin: https://api.deepseek.com
DEEPSEEK_PROVIDER=openai
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_NAME=deepseek-chat

# --- LLM thinking (optional; falls back to LLM_* if empty) ---
LLM_THINKING_PROVIDER=
LLM_THINKING_BASE_URL=
LLM_THINKING_API_KEY=
LLM_THINKING_MODEL_NAME=

# --- VLM (optional; falls back to LLM_* if empty) ---
VLM_PROVIDER=
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL_NAME=
