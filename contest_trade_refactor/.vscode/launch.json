{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Backend: FastAPI Web (CN-Stock)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "web_app:app",
                "--host",
                "0.0.0.0",
                "--port",
                "8000"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {
                "CONTEST_TRADE_MARKET": "CN-Stock"
            },
            "justMyCode": true
        },
        {
            "name": "Backend: FastAPI Web (US-Stock)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "web_app:app",
                "--host",
                "0.0.0.0",
                "--port",
                "8000"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {
                "CONTEST_TRADE_MARKET": "US-Stock"
            },
            "justMyCode": true
        },
        {
            "name": "Backend: Main Loop (CN-Stock)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main_loop.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {
                "CONTEST_TRADE_MARKET": "CN-Stock"
            },
            "justMyCode": true
        },
        {
            "name": "Backend: Main Loop (US-Stock)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main_loop.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {
                "CONTEST_TRADE_MARKET": "US-Stock"
            },
            "justMyCode": true
        },
        {
            "name": "Backend: Current Python File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
